{
  "name": "incident-time-machine",
  "version": "1.0.0",
  "description": "Incident Time Machine — instant historical triage for Jira Service Management incidents. Codegeist 2026 entry.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
